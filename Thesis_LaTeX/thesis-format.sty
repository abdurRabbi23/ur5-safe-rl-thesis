% =====================================================================
%  thesis-format.sty -- KUET Mechatronics Engineering thesis format
% =====================================================================
%  Implements the measured specification in KUET_FORMAT_SPEC.md, which was
%  extracted from the official department templates in kuet_thesis_style/.
%  If this file and that file ever disagree, KUET_FORMAT_SPEC.md is right.
%
%  Every value below carries the spec section it came from. Do not "tidy"
%  a number without checking the spec first -- several of them look wrong
%  and are not (the asymmetric margins, the footer alignment changing
%  between front matter and body, captions not being bold).
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis-format}[2026/08/02 KUET MTE thesis format]

% ---------- draft / final option --------------------------------------
\newif\ifthesisdraft
\DeclareOption{draft}{\thesisdrafttrue}
\DeclareOption{final}{\thesisdraftfalse}
\ExecuteOptions{draft}
\ProcessOptions\relax

% ---------- fonts (spec 3) --------------------------------------------
% Times New Roman throughout. newtx is the preferred clone; mathptmx is
% the fallback so the project still builds on a minimal TeX install.
% Both are metric-compatible, so the page layout does not move.
\IfFileExists{newtxtext.sty}{%
  \RequirePackage{newtxtext}\RequirePackage{newtxmath}%
}{%
  \PackageWarning{thesis-format}{newtx not found -- falling back to mathptmx}%
  \RequirePackage{mathptmx}%
}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

% ---------- page setup (spec 1) ---------------------------------------
% A4. 30 mm top and left (binding edge), 25 mm right and bottom.
% No running header -- the body template has no header part at all.
% Word places the footer 12.7 mm from the paper edge.
\RequirePackage[a4paper,
                top=30mm, left=30mm, right=25mm, bottom=25mm,
                footskip=12mm, headheight=0pt, headsep=0pt]{geometry}

% ---------- line spacing (spec 3) -------------------------------------
% Word "1.5 lines" == setspace \onehalfspacing. LaTeX's baseline is
% already 1.2x the font size, so the correct stretch factor is
% 1.5/1.2 = 1.25 -- which is why the repo's old "1.25" note and the
% template's "1.5" were very likely the same instruction all along.
% Use \onehalfspacing, not \setstretch{1.5}: the latter gives Word 1.8.
\RequirePackage{setspace}
\onehalfspacing

% ---------- paragraphs (spec 8, C5) -----------------------------------
% The Word Normal style has no first-line indent and zero space-after,
% so Word users separate paragraphs with empty paragraphs. Confirmed
% 2026-08-02: block paragraphs, 6 pt apart, no indent.
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% ---------- maths, tables, floats -------------------------------------
\RequirePackage{amsmath,amssymb}
\RequirePackage{array,booktabs,longtable,multirow,tabularx}
\RequirePackage{graphicx}
\RequirePackage{float}
% TikZ, for the redrawn RL taxonomy in Chapter 3. Added 2026-08-03.
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta}
\renewcommand{\arraystretch}{1.2}
\graphicspath{{figures/}}

% Table body text is 12 pt (spec 4). The template contradicts itself here
% -- the MTE_Thesis_Table style says 10 pt -- and 12 pt was confirmed.
% Tables are set single-spaced at 11 pt, not at the body's 1.5 spacing. Standard
% thesis practice and the reason Chapter 3's table-heavy sections fit. Set
% 2026-08-03. Revert to body setting with \newcommand{\tablesize}{\normalsize}.
\newcommand{\tablesize}{\setstretch{1}\fontsize{11}{13}\selectfont}

% ---------- captions (spec 4) -----------------------------------------
% 10 pt, centred, NOT bold, 6 pt above and below, "Table 1.1. Title"
% with a full stop after the number. In a 12 pt class \footnotesize is
% exactly 10 pt.
\RequirePackage[font=footnotesize,
                labelfont=normalfont,
                labelsep=period,
                justification=centering,
                singlelinecheck=true,
                aboveskip=6pt, belowskip=6pt]{caption}

% Table captions go ABOVE the table, figure captions BELOW the figure.
% \kuettable and \kuetfigure enforce that so it cannot be got wrong.
% Optional first argument overrides the float placement (default htbp), exactly as
% for kuetfigure below, e.g. \begin{kuettable}[H]{caption}{label}. Existing
% two-brace calls are unaffected. Use [H] when a table sits immediately before a
% list or a summary block: at htbp the float can drift INTO the list and split it,
% which is what happened to the Chapter 3 training-protocol block on 2026-08-03.
\newenvironment{kuettable}[3][htbp]% [placement]{caption}{label}
  {\begin{table}[#1]\centering\caption{#2}\label{#3}\tablesize}
  {\end{table}}
% (the end-part of an environment cannot see #1/#2, so stash them first)
\makeatletter
\newcommand{\kf@cap}{}\newcommand{\kf@lab}{}
% Optional first argument overrides the float placement (default htbp), e.g.
% \begin{kuetfigure}[b]{caption}{label} to force the figure to the bottom of
% the page instead of floating inline where it is written. Existing two-brace
% calls are unaffected, they still get the htbp default.
\newenvironment{kuetfigure}[3][htbp]% [placement]{caption}{label}
  {\renewcommand{\kf@cap}{#2}\renewcommand{\kf@lab}{#3}%
   \begin{figure}[#1]\centering}
  {\caption{\kf@cap}\label{\kf@lab}\end{figure}}
\makeatother

% ---------- headings (spec 3) -----------------------------------------
\RequirePackage{titlesec}

% Chapter: 14 pt bold centred, two centred lines with the title in caps --
%   CHAPTER 1
%   INTRODUCTION
% Measured off the accepted book, kuet_thesis_style/Thesis_book_draft_3.pdf.
\titleformat{\chapter}[display]
  {\centering\normalfont\fontsize{14}{18}\bfseries}
  {CHAPTER \thechapter}{6pt}{\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}

% Section: 12 pt bold, left, 6 pt before and after.
\titleformat{\section}
  {\normalfont\fontsize{12}{18}\bfseries}{\thesection}{1em}{}
\titlespacing*{\section}{0pt}{6pt}{6pt}

% Sub-section: 12 pt BOLD ITALIC, left, 6 pt before and after.
% DELIBERATE DEVIATION from the measured template, set 2026-08-03 on Touhid's
% instruction. KUET_FORMAT_SPEC.md row 50 records the accepted book as 12 pt
% *italic* (not bold). Bold italic keeps the template's italic while giving the
% sub-headings the weight he wanted. Revert by deleting \bfseries below.
\titleformat{\subsection}
  {\normalfont\fontsize{12}{18}\bfseries\itshape}{\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{6pt}{6pt}

% Sub-sub-section: not specified by the template. Matches the sub-section.
\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{18}\bfseries\itshape}{\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{6pt}{6pt}

% Front-matter page titles: 14 pt bold centred, same as a chapter head.
\newcommand{\kuetfrontheading}[1]{%
  \phantomsection
  \begin{center}\normalfont\fontsize{14}{18}\bfseries\MakeUppercase{#1}\end{center}
  \addcontentsline{toc}{chapter}{#1}%
  \vspace{6pt}}

% ---------- page numbering (spec 2) -----------------------------------
% Front matter: lower-case roman, footer CENTRED.
% Body: arabic, footer RIGHT-ALIGNED. No headers anywhere.
\RequirePackage{fancyhdr}
\fancypagestyle{kuetfront}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\thepage}}
\fancypagestyle{kuetbody}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[R]{\thepage}}

% Chapter-opening pages use \thispagestyle{plain}; redefine plain to
% follow whichever section we are in.
\newcommand{\kuetfrontmatterstyle}{%
  \pagestyle{kuetfront}%
  \fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
    \fancyfoot[C]{\thepage}}}
\newcommand{\kuetbodystyle}{%
  \pagestyle{kuetbody}%
  \fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
    \fancyfoot[R]{\thepage}}}

% ---------- lists -----------------------------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=2pt,parsep=0pt,topsep=4pt}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ---------- colour and links ------------------------------------------
\RequirePackage{xcolor}
\definecolor{draftred}{HTML}{B3261E}
\RequirePackage[hidelinks,breaklinks=true]{hyperref}
\hypersetup{colorlinks=false}   % printed book: no coloured link boxes

% ---------- draft machinery -------------------------------------------
%   draftnote : provenance / working notes attached to a chapter
%   draftonly : material kept in the file but never printed in the book
%   \todocite : an unsourced citation placeholder, loud on purpose
\RequirePackage{comment}
\RequirePackage{mdframed}

\ifthesisdraft
  \newmdenv[linecolor=draftred,linewidth=0.6pt,backgroundcolor=draftred!4,
            skipabove=8pt,skipbelow=8pt,innertopmargin=6pt,innerbottommargin=6pt,
            frametitle={\small\bfseries\color{draftred}Draft note --- not part of the book}]
           {draftnote}
  \newenvironment{draftonly}{}{}
  \newcommand{\todocite}[1]{{\bfseries\color{draftred}[TODO-#1]}}
  \newcommand{\todo}[1]{{\bfseries\color{draftred}[TODO: #1]}}
\else
  \excludecomment{draftnote}
  \excludecomment{draftonly}
  \newcommand{\todocite}[1]{\PackageError{thesis-format}%
    {Unsourced citation placeholder TODO-#1 still present}%
    {Replace \string\todocite{#1} with a real \string\cite before the final build.}}
  \newcommand{\todo}[1]{\PackageError{thesis-format}%
    {Unresolved TODO still present: #1}%
    {Resolve it before the final build.}}
\fi

\endinput
